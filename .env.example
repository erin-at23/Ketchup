# Copy to .env (repo root) and fill in. Never commit .env.
# Both backend/ and audio/ read this one file.

# Where the backend runs. Same laptop: localhost. Over a tunnel: the https://...trycloudflare.com URL.
REWIND_API=http://localhost:8001

# Which AI writes recaps and answers (frequent calls), and which writes the end-of-session report (one call).
# The other AI is the backup.
LLM_PROVIDER=openai
REPORT_PROVIDER=gemini

# Recaps (Gemini 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_THINKING=low

# Optional backup AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Recap voice (optional: falls back to the browser's voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Lecture transcription
DEEPGRAM_API_KEY=

# Backend tuning (optional)
RECAP_DELAY=6
FAKE_MODE=0
