# Copy to .env (repo root) and fill in. Never commit .env.

# Where the backend runs (camera/audio/voice use this too)
REWIND_API=http://localhost:8001

# AI for recaps, answers and the end-of-session report
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Lecture transcription (Vexo band audio)
DEEPGRAM_API_KEY=

# Recap voice (optional: falls back to the browser's voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Tuning (optional)
RECAP_DELAY=6
