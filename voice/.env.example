# Rewind P4 voice agent. Copy to .env and fill in; never commit .env.
# P3's backend (same as camera/.env). The tool calls GET $REWIND_API/recap/latest
REWIND_API=https://myrtle-scripts-awesome-constitutional.trycloudflare.com

# Deepgram speech-to-text (shared with P2)
DEEPGRAM_API_KEY=

# LLM: openai (default) or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# only if LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=

# ElevenLabs text-to-speech: a turbo/flash model, a calm, clear, friendly voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
