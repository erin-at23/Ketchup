# Backend from P3 (leave empty to just print events)
REWIND_API=http://localhost:8787
# Optional: where P3 serves recent transcript lines (GET ?since=<epoch>)
REWIND_TRANSCRIPT_PATH=/transcript

# Gemini relevance check (leave empty to use the "phone in view" fallback)
GEMINI_API_KEY=
GEMINI_MODEL=
# One line about the lecture, used in the relevance prompt
REWIND_TOPIC=Intro to C++: vectors and memory

# Which camera is the glasses camera (find it with: python3 drift.py --list-cameras)
CAMERA_INDEX=0

# Use OpenAI instead of Gemini for the relevance check (fill in your own key in .env, never commit it)
JUDGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
